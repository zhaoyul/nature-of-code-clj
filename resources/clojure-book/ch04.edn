 {:index 29 :source "(let [animals (into {} (for [[kind n] [[:dog 10] [:cat 15] [:turtle 6] [:kiwi 98]]]\n                        [kind (vec (repeat n (lesson/animal kind)))]))]\n  (into {} (map (fn [[kind xs]] [kind (count xs)]) animals)))"}
