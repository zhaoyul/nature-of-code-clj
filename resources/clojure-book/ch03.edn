 {:index 5 :source "(let [{:keys [position radius angle]} lesson/mover]\n  (notebook/scene\n   (d/scene [[:push] (into [:translate] position) [:rotate angle]]\n            (d/circle [0 0] (* radius 2) [175 175 175 200])\n            (d/line [0 0] [radius 0]) [[:pop]])))"}
