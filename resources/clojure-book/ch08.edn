 {:index 0 :source "(letfn [(some-function [] [[:background 0]])]\n  (notebook/scene (some-function)))"}
 {:index 1 :source "(letfn [(some-function [remaining]\n          (if (zero? remaining)\n            [:finished]\n            (into [remaining] (some-function (dec remaining)))))]\n  (some-function 10))" :note "原例的无终止条件递归会一直调用自身；本执行单元显式添加 remaining，记录十层调用后终止。"}
 {:index 2 :source "(letfn [(factorial [n]\n          (reduce *' 1 (range 1 (inc n))))]\n  (mapv factorial (range 0 7)))"}
